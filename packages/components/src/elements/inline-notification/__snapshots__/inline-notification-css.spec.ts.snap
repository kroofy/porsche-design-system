    mask: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18 3H6a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h4l2 2 2-2h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2m-5 3.5-.4 5.5h-1.2L11 6.5zm-2 7h2v2h-2z"/></svg>') center/contain no-repeat;
  }
@media(forced-colors:active) {
    .p-inline-notification::before {
      background: CanvasText;
    }
}

  .p-inline-notification .p-inline-notification__action {
    grid-area: 1/3;
    margin-top: 0px;
    margin-inline-start: var(--p-spacing-static-md);
  }
}

@media(forced-colors:active) {
  .p-inline-notification {
    outline: 2px solid CanvasText;
    outline-offset: -2px;
  }
  .p-inline-notification .p-inline-notification__dismiss {
    forced-color-adjust: none;
    background: Canvas;
    box-shadow: inset 0 0 0 2px ButtonBorder;
    color: ButtonText;
  }
  .p-inline-notification .p-inline-notification__dismiss:focus-visible {
    outline-color: Highlight;
  }
}

@media(hover:hover) {
  .p-inline-notification .p-inline-notification__dismiss:hover {
    background-color: var(--p-color-frosted);

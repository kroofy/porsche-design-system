{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "outDir": "../node_modules/.emit-check/angular",
    "rootDir": "../..",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["../../components/mitosis/*/output/frameworks/angular/*.ts", "./scope-css.d.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}

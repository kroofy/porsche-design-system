".p-button-pure{color-scheme:inherit}
@layer pds.elements {
.p-button-pure {
  all: unset;
  display: inline-flex;
  width: auto;
  justify-content: flex-start;
  align-items: flex-start;
  vertical-align: top;
  position: relative;
  box-sizing: border-box;
  cursor: pointer;
  color: var(--p-color-primary);
  text-decoration: none;
  font: var(--p-font-weight-normal) var(--p-typescale-sm)/var(--p-leading-normal) var(--p-font-porsche-next);
  gap: var(--p-spacing-static-xs);
  transform: translate3d(0,0,0);
}
.p-button-pure::before {
  content: "";
  position: absolute;
  top: -2px;
  bottom: -2px;
  left: -4px;
  right: -4px;
  border-radius: var(--p-radius-lg);
  transition: background-color var(--p-transition-duration,var(--p-duration-sm)) var(--p-ease-in-out);
}
.p-button-pure:focus-visible::before {
  outline: 2px solid var(--p-color-focus);
  outline-offset: 2px;
}
.p-button-pure[hidden] {
  display: none !important;
}
.p-button-pure[data-p-underline="true"] {
  text-decoration: underline;
}
.p-button-pure[data-p-active="true"]::before {
  -webkit-backdrop-filter: var(--p-blur-frosted);
  backdrop-filter: var(--p-blur-frosted);
  background-color: var(--p-color-frosted);
}
.p-button-pure .p-button-pure__icon {
  position: relative;
  flex-shrink: 0;
  width: var(--p-leading-normal);
  height: var(--p-leading-normal);
}
.p-button-pure .p-button-pure__label {
  z-index: 1;
}
.p-button-pure[data-p-icon="none"] .p-button-pure__label {
  position: relative;
  z-index: auto;
}
.p-button-pure .p-button-pure__spinner {
  --p-spinner-color: currentcolor;
  position: relative;
  flex-shrink: 0;

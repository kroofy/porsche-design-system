{
  "name": "@porsche-design-system/components",
  "version": "4.7.0-beta.0",
  "private": true,
  "license": "UNLICENSED",
  "scope": "@porsche-design-system",
  "author": "Dr. Ing. h.c. F. Porsche AG",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "es2015": "dist/esm/index.js",
  "es2017": "dist/esm/index.js",
  "jsnext:main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "prestart": "npm run prestart:prepareAriaTypes && npm run prestart:buildStylesheets",
    "prestart:prepareAriaTypes": "tsx scripts/prepareAriaTypes.ts",
    "prestart:buildStylesheets": "npm run build --workspace=@porsche-design-system/stylesheets",
    "start": "concurrently -k -s 'first' -n 'cdn,tailwindcss,playground' 'serve-cdn' 'tailwindcss -i ./src/tailwind.css -o ./src/assets/tailwind.css --watch' 'node scripts/serve-playground.mjs'",
    "build:lit-divider": "node scripts/build-lit-divider.mjs",
    "generate:frameworks-divider": "node scripts/generate-frameworks-divider.mjs",
    "generate:frameworks-all": "node scripts/generate-frameworks-all.mjs",
    "generate:frameworks-react-fix": "node scripts/generate-frameworks-react-fix.mjs",
    "build:lit-crest": "node scripts/build-lit-crest.mjs",
    "build:lit-wordmark": "node scripts/build-lit-wordmark.mjs",
    "build:lit-flag": "node scripts/build-lit-flag.mjs",
    "build:lit-model-signature": "node scripts/build-lit-model-signature.mjs",
    "build:lit-icon": "node scripts/build-lit-icon.mjs",
    "build:lit-heading": "node scripts/build-lit-heading.mjs",
    "build:lit-text": "node scripts/build-lit-text.mjs",
    "build:lit-display": "node scripts/build-lit-display.mjs",
    "build:lit-spinner": "node scripts/build-lit-spinner.mjs",
    "build:lit-tag": "node scripts/build-lit-tag.mjs",
    "build:lit-tag-dismissible": "node scripts/build-lit-tag-dismissible.mjs",
    "build:lit-link-pure": "node scripts/build-lit-link-pure.mjs",
    "build:lit-link": "node scripts/build-lit-link.mjs",
    "build:lit-button-pure": "node scripts/build-lit-button-pure.mjs",
    "build:lit-button": "node scripts/build-lit-button.mjs",
    "build:lit-switch": "node scripts/build-lit-switch.mjs",
    "build:lit-checkbox": "node scripts/build-lit-checkbox.mjs",
    "build:lit-input-text": "node scripts/build-lit-input-text.mjs",
    "build:lit-input-email": "node scripts/build-lit-input-email.mjs",
    "build:lit-input-password": "node scripts/build-lit-input-password.mjs",
    "build:lit-input-search": "node scripts/build-lit-input-search.mjs",
    "build:lit-input-url": "node scripts/build-lit-input-url.mjs",
    "build:lit-input-tel": "node scripts/build-lit-input-tel.mjs",
    "build:lit-input-number": "node scripts/build-lit-input-number.mjs",
    "build:lit-input-date": "node scripts/build-lit-input-date.mjs",
    "build:lit-input-month": "node scripts/build-lit-input-month.mjs",
    "build:lit-input-time": "node scripts/build-lit-input-time.mjs",
    "build:lit-input-week": "node scripts/build-lit-input-week.mjs",
    "build:lit-textarea": "node scripts/build-lit-textarea.mjs",
    "build:lit-fieldset": "node scripts/build-lit-fieldset.mjs",
    "build:lit-text-list": "node scripts/build-lit-text-list.mjs",
    "build:lit-text-list-item": "node scripts/build-lit-text-list-item.mjs",
    "build:lit-ai-tag": "node scripts/build-lit-ai-tag.mjs",
    "build:lit-inline-notification": "node scripts/build-lit-inline-notification.mjs",
    "build:lit-banner": "node scripts/build-lit-banner.mjs",
    "build:lit-pagination": "node scripts/build-lit-pagination.mjs",
    "build:lit-scroller": "node scripts/build-lit-scroller.mjs",
    "build:lit-pin-code": "node scripts/build-lit-pin-code.mjs",
    "build:lit-accordion": "node scripts/build-lit-accordion.mjs",
    "build:lit-segmented-control": "node scripts/build-lit-segmented-control.mjs",
    "build:lit-segmented-control-item": "node scripts/build-lit-segmented-control-item.mjs",
    "build:lit-radio-group": "node scripts/build-lit-radio-group.mjs",
    "build:lit-radio-group-option": "node scripts/build-lit-radio-group-option.mjs",
    "build:lit-select": "node scripts/build-lit-select.mjs",
    "build:lit-select-option": "node scripts/build-lit-select-option.mjs",
    "build:lit-optgroup": "node scripts/build-lit-optgroup.mjs",
    "build:lit-multi-select": "node scripts/build-lit-multi-select.mjs",
    "build:lit-multi-select-option": "node scripts/build-lit-multi-select-option.mjs",
    "build:lit-tabs-bar": "node scripts/build-lit-tabs-bar.mjs",
    "build:lit-tabs": "node scripts/build-lit-tabs.mjs",
    "build:lit-tabs-item": "node scripts/build-lit-tabs-item.mjs",
    "build:lit-stepper-horizontal": "node scripts/build-lit-stepper-horizontal.mjs",
    "build:lit-stepper-horizontal-item": "node scripts/build-lit-stepper-horizontal-item.mjs",
    "build:lit-button-tile": "node scripts/build-lit-button-tile.mjs",
    "build:lit-link-tile": "node scripts/build-lit-link-tile.mjs",
    "build:lit-link-tile-product": "node scripts/build-lit-link-tile-product.mjs",
    "build:lit-popover": "node scripts/build-lit-popover.mjs",
    "build:lit-table": "node scripts/build-lit-table.mjs",
    "build:lit-table-head": "node scripts/build-lit-table-head.mjs",
    "build:lit-table-head-row": "node scripts/build-lit-table-head-row.mjs",
    "build:lit-table-head-cell": "node scripts/build-lit-table-head-cell.mjs",
    "build:lit-table-body": "node scripts/build-lit-table-body.mjs",
    "build:lit-table-row": "node scripts/build-lit-table-row.mjs",
    "build:lit-table-cell": "node scripts/build-lit-table-cell.mjs",
    "build:lit-toast": "node scripts/build-lit-toast.mjs",
    "build:lit-toast-item": "node scripts/build-lit-toast-item.mjs",
    "build:lit-modal": "node scripts/build-lit-modal.mjs",
    "build:lit-flyout": "node scripts/build-lit-flyout.mjs",
    "build:lit-sheet": "node scripts/build-lit-sheet.mjs",
    "build:lit-drilldown": "node scripts/build-lit-drilldown.mjs",
    "build:lit-drilldown-item": "node scripts/build-lit-drilldown-item.mjs",
    "build:lit-drilldown-link": "node scripts/build-lit-drilldown-link.mjs",
    "build:lit-carousel": "node scripts/build-lit-carousel.mjs",
    "build:lit-canvas": "node scripts/build-lit-canvas.mjs",
    "prebuild": "npm run clean:build && npm run prebuild:generateConstructorMap",
    "prebuild:generateConstructorMap": "tsx scripts/generateConstructorMap.ts",
    "build": "npm run prebuild:generateConstructorMap",
    "build:stylesheets": "npm run build --workspace=@porsche-design-system/stylesheets",
    "build:stylesheets-prod": "npm run build-prod --workspace=@porsche-design-system/stylesheets",
    "build:wrappers": "npm run build:wrappers:generateWrappers && npm run build:wrappers:generateDSRComponents && npm run build:wrappers:bundleStyles && npm run build:wrappers:bundleUtils",
    "build:wrappers:generateWrappers": "tsx scripts/generateWrappers.ts",
    "build:wrappers:generateDSRComponents": "tsx scripts/generateDSRComponents.ts",
    "build:wrappers:bundleStyles": "rm -rf ./src/styles-entry.ts && PDS_IS_STAGING=${PDS_IS_STAGING:-1} rollup -c rollup-styles.config.mjs",
    "build:wrappers:bundleUtils": "rm -rf ./src/utils-entry.ts && PDS_IS_STAGING=${PDS_IS_STAGING:-1} rollup -c rollup-utils.config.mjs",
    "build:type": "npm run build:type:addMissingTypeExport && npm run build:type:bundle",
    "build:type:addMissingTypeExport": "tsx scripts/addMissingTypeExport.ts",
    "build:type:bundle": "dts-bundle-generator -o ./dist/types/bundle.d.ts ./dist/types/index.d.ts --inline-declare-global --external-types --no-banner",
    "build:cleanReadmes": "tsx scripts/cleanReadmes.ts",
    "build:copyCjsBuildToComponentsJs": "TARGET=../components-js/projects/jsdom-polyfill/src/lib && rm -rf $TARGET && cp -r ./dist/cjs $TARGET",
    "build:addTableOfContents": "tsx scripts/addTableOfContents.ts",
    "build:clean": "npm run build:clean:loader && npm run build:clean:componentsReady && npm run build:clean:deletePolyfills && npm run build:clean:deleteGeneratedLoader",
    "build:clean:loader": "tsx scripts/cleanupLoader.ts",
    "build:clean:componentsReady": "tsx scripts/cleanupComponentsReady.ts",
    "build:clean:deletePolyfills": "rm -rf ./dist/esm/polyfills",
    "build:clean:deleteGeneratedLoader": "rm -rf ./dist/loader",
    "build-prod": "PDS_IS_STAGING=0 npm run build",
    "test": "npm run test:unit",
    "pretest:unit": "npm run prebuild:generateConstructorMap",
    "test:unit": "vitest -c tests/unit/config/vitest.config.ts",
    "clean:build": "rm -rf ./.stencil && rm -rf ./dist && rm -rf ./www && rm -rf ./src/styles-entry.ts && rm -rf ./src/utils-entry.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@porsche-design-system/emotion": "0.0.0",
    "@porsche-design-system/icons": "0.0.0",
    "@porsche-design-system/model-signatures": "0.0.0",
    "@porsche-design-system/shared": "0.0.0",
    "@porsche-design-system/tokens": "0.0.0",
    "@splidejs/splide": "^4.1.4"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "change-case": "^5.4.4",
    "concurrently": "^10.0.4",
    "construct-style-sheets-polyfill": "^3.1.0",
    "dts-bundle-generator": "^9.5.1",
    "fast-glob": "^3.3.3",
    "jss": "^10.10.0",
    "jss-plugin-sort-css-media-queries": "^1.0.1-beta.0",
    "jss-preset-default": "^10.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3"
  },
  "volta": {
    "extends": "../../package.json"
  }
}

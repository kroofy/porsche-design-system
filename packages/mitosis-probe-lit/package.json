{
  "name": "mitosis-probe-lit",
  "version": "0.0.0",
  "private": true,
  "description": "Throwaway fitness probe: Mitosis Lit target for p-divider. Not wired into the monorepo build. Install with --workspaces=false.",
  "scripts": {
    "build": "mitosis build && esbuild output/lit/src/Divider.ts --bundle --format=iife --tsconfig=tsconfig.json --alias:lit/decorators=lit/decorators.js --outfile=harness/lit-divider.bundle.js",
    "verify": "node harness/verify.mjs",
    "pixel-diff": "node harness/pixel-diff.mjs"
  },
  "devDependencies": {
    "@builder.io/mitosis": "^0.14.0",
    "@builder.io/mitosis-cli": "^0.14.0",
    "lit": "^3.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}

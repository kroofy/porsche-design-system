  }
  .p-link-pure[data-p-size-xxl="large"] {
    font-size: var(--p-typescale-lg);
  }
  .p-link-pure[data-p-size-xxl="x-large"] {
    font-size: var(--p-typescale-xl);
  }
  .p-link-pure[data-p-color-xxl="primary"] {
    color: var(--p-color-primary);
  }
  .p-link-pure[data-p-color-xxl="contrast-higher"] {
    color: var(--p-color-contrast-higher);
  }
  .p-link-pure[data-p-color-xxl="contrast-high"] {
    color: var(--p-color-contrast-high);
  }
  .p-link-pure[data-p-color-xxl="contrast-medium"] {
    color: var(--p-color-contrast-medium);
  }
  .p-link-pure[data-p-color-xxl="inherit"] {
    color: currentcolor;
  }
  .p-link-pure[data-p-align-label-xxl="end"] .p-link-pure__label {
    order: 0;
  }
  .p-link-pure[data-p-align-label-xxl="start"] .p-link-pure__label {
    order: -1;
  }
  .p-link-pure[data-p-hide-label-xxl="false"]::before {
    inset-inline: -4px;
    border-radius: var(--p-radius-lg);
  }
  .p-link-pure[data-p-hide-label-xxl="false"]:not([data-p-icon="none"]) .p-link-pure__label {
    white-space: inherit;
    text-indent: 0;
    overflow: visible;
  }
  .p-link-pure[data-p-hide-label-xxl="true"]::before {
    inset-inline: -2px;
    border-radius: var(--p-radius-full);
  }
  .p-link-pure[data-p-hide-label-xxl="true"]:not([data-p-icon="none"]) .p-link-pure__label {
    white-space: nowrap;
    text-indent: -999999px;
    overflow: hidden;
  }
@media(forced-colors:active) {
    .p-link-pure[data-p-color-xxl="inherit"] {
      color: LinkText;
    }
    .p-link-pure[data-p-color-xxl="contrast-medium"] {
      color: LinkText;
    }
    .p-link-pure[data-p-color-xxl="contrast-high"] {
      color: LinkText;
    }
    .p-link-pure[data-p-color-xxl="contrast-higher"] {
      color: LinkText;
    }
    .p-link-pure[data-p-color-xxl="primary"] {
      color: LinkText;
    }
}

}

@media(forced-colors:active) {
  .p-link-pure {
    color: LinkText;
  }
  .p-link-pure[data-p-color="inherit"] {
    color: LinkText;
  }
  .p-link-pure[data-p-color="contrast-medium"] {
    color: LinkText;
  }
  .p-link-pure[data-p-color="contrast-high"] {
    color: LinkText;
  }
  .p-link-pure[data-p-color="contrast-higher"] {
    color: LinkText;
  }
  .p-link-pure[data-p-color="primary"] {
    color: LinkText;
  }
  .p-link-pure:focus-visible::before {
    outline-color: Highlight;
  }
}

@media(hover:hover) {
  .p-link-pure:hover::before {
    -webkit-backdrop-filter: var(--p-blur-frosted);
    backdrop-filter: var(--p-blur-frosted);
    background-color: var(--p-color-frosted-strong);
  }
}
}
"
`;

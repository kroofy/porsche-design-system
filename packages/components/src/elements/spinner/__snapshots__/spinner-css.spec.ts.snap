".p-spinner{color-scheme:inherit}
@layer pds.elements {
@keyframes p-spin-rotate {
  0% {
    transform: rotateZ(0deg);
  }
  100% {
    transform: rotateZ(360deg);
  }
}
@keyframes p-spin-dash {
  0% {
    stroke-dashoffset: 69;
    transform: rotateZ(0);
  }
  50%, 75% {
    stroke-dashoffset: 24;
    transform: rotateZ(80deg);
  }
  100% {
    stroke-dashoffset: 69;
    transform: rotateZ(360deg);
  }
}
  .p-spinner {
    display: inline-flex;
    vertical-align: top;
    width: var(--p-spinner-size,var(--p-leading-normal));
    height: var(--p-spinner-size,var(--p-leading-normal));
    font-family: var(--p-font-porsche-next);
    font-size: var(--p-typescale-sm);
    fill: none;
    stroke-width: 1.5;
    animation: p-spin-rotate var(--p-animation-duration,var(--p-duration-xl)) steps(50) infinite;
  }
  .p-spinner[hidden] {
    display: none !important;
  }
  .p-spinner > circle:first-child {
    stroke: var(--p-spinner-track-color,var(--p-color-contrast-lower));
  }
  .p-spinner > circle:last-child {
    stroke-dasharray: var(--p-temporary-spinner-stroke-dasharray,69);
    stroke-linecap: round;
    animation: p-spin-dash var(--p-animation-duration,var(--p-duration-xl)) steps(50) infinite;
    stroke: var(--p-spinner-color,var(--p-color-primary));

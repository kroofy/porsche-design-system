".p-button-tile{color-scheme:dark}
@layer pds.elements {
.p-button-tile {
  all: unset;
  display: grid;
  grid-template: var(--p-spacing-fluid-md) auto minmax(0px, 1fr) auto var(--p-spacing-fluid-md)/var(--p-spacing-fluid-md) minmax(0px, 1fr) var(--p-spacing-fluid-md);
  aspect-ratio: 4/3;
  width: 100%;
  box-sizing: border-box;
  border-radius: var(--p-radius-3xl);
  hyphens: auto;
  cursor: pointer;
  text-align: start;
  color: var(--p-color-primary);
}
.p-button-tile[hidden] {
  display: none !important;
}
.p-button-tile:disabled {
  cursor: not-allowed;
}
.p-button-tile:disabled:not([data-p-loading]) .p-button {
  opacity: 0.4;
}
.p-button-tile:focus-visible {
  outline: 2px solid var(--p-color-focus);
  outline-offset: 2px;
}
.p-button-tile .p-button-tile__media {
  position: relative;
  grid-area: 1/1/-1 /-1;
  z-index: 1;
  overflow: hidden;
  border-radius: inherit;
}
.p-button-tile .p-button-tile__media > img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--p-transition-duration,var(--p-duration-md)) var(--p-ease-in-out);
}
.p-button-tile .p-button-tile__media > video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--p-transition-duration,var(--p-duration-md)) var(--p-ease-in-out);
}
.p-button-tile .p-button-tile__media > picture {
  display: block;
  width: 100%;
  height: 100%;
  transition: transform var(--p-transition-duration,var(--p-duration-md)) var(--p-ease-in-out);
}
.p-button-tile .p-button-tile__media > picture > img {

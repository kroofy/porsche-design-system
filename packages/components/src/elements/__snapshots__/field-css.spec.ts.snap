    border-color: var(--p-color-error);
  }
  .p-textarea:hover:not(:disabled):not([readonly]):not([data-p-loading="true"]) {
    border-color: var(--p-color-primary);
  }
  .p-textarea[data-p-state="success"]:hover:not(:disabled):not([readonly]):not([data-p-loading="true"]) {
    border-color: var(--p-color-success);
  }
  .p-textarea[data-p-state="error"]:hover:not(:disabled):not([readonly]):not([data-p-loading="true"]) {
    border-color: var(--p-color-error);
  }
  .p-select:hover:not(:disabled):not([readonly]):not([data-p-loading="true"]) {
    border-color: var(--p-color-primary);
  }
  .p-select[data-p-state="success"]:hover:not(:disabled):not([readonly]):not([data-p-loading="true"]) {
    border-color: var(--p-color-success);
  }
  .p-select[data-p-state="error"]:hover:not(:disabled):not([readonly]):not([data-p-loading="true"]) {
    border-color: var(--p-color-error);
  }
  .p-checkbox:hover {
    border-color: var(--p-checkbox-border-color,var(--p-color-primary));
  }
  .p-checkbox[data-p-state="success"]:hover:not(:disabled):not([data-p-loading="true"]) {
    border-color: var(--p-color-success);
  }
  .p-checkbox[data-p-state="error"]:hover:not(:disabled):not([data-p-loading="true"]) {
    border-color: var(--p-color-error);
  }
  .p-checkbox:checked:hover {
    background-color: var(--p-checkbox-border-color,var(--p-color-contrast-high));
    border-color: transparent;
  }
  .p-radio:hover:not(:disabled):not([data-p-loading="true"]) {
    border-color: var(--p-color-primary);
  }
  .p-radio[data-p-state="success"]:hover:not(:disabled):not([data-p-loading="true"]) {
    border-color: var(--p-color-success);
  }
  .p-radio[data-p-state="error"]:hover:not(:disabled):not([data-p-loading="true"]) {
    border-color: var(--p-color-error);
  }
}
}
"
`;

  .p-link-tile[data-p-size-xxl="medium"] .p-link-tile__description {
    font-size: var(--p-typescale-md);
  }
}

@media(forced-colors:active) {
  .p-link-tile:focus-visible {
    outline-color: Highlight;
  }
}

@media(hover:hover) {
  .p-link-tile:hover .p-link-tile__media > img {
    transform: scale3d(1.05,1.05,1.05);
  }
  .p-link-tile:hover .p-link-tile__media > video {
    transform: scale3d(1.05,1.05,1.05);
  }
  .p-link-tile:hover .p-link-tile__media > picture {
    transform: scale3d(1.05,1.05,1.05);
  }
}

@supports (-webkit-hyphens: auto) {
  .p-link-tile {
    height: 100%;
    align-items: baseline;
  }
}
}
"
`;
